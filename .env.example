# Facultatif : si vide, le serveur s'attache au terminal MT5 déjà ouvert et connecté.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Chemin du terminal si plusieurs installations MT5 (ex. C:\Program Files\AvaTrade MT5 Terminal\terminal64.exe)
MT5_PATH=
# Volume maximum autorisé par ordre, en lots
MT5_MAX_VOLUME=1.0
